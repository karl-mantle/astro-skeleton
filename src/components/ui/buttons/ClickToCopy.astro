---
import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";

interface Props extends HTMLAttributes<"button"> {
  text?: string;
  label?: string;
  labelSuccess?: string;
}

const {
  text = `${Astro.url}`, // leave blank to use current page URL
  label,
  labelSuccess,
  class: className,
  ...rest
}: Partial<Props> = Astro.props;
---

<button
  class:list={[
    "not-prose group/btn hover:border-base-950 focus-visible:bg-focus-color hover:text-base-950 flex w-fit cursor-pointer items-center justify-center gap-2 border-b-2 border-transparent p-1 font-medium transition-all duration-300 focus-visible:border-b-2 focus-visible:border-black focus-visible:text-black dark:hover:border-white dark:hover:text-white",
    !label && !labelSuccess
      ? "hover:bg-base-200 dark:hover:bg-base-800 !gap-0 border-none p-2"
      : "", // icon only styles
    className,
  ]}
  type="button"
  aria-label="Copy to clipboard"
  data-copy-btn
  data-copy-text={text}
  {...rest}
>
  {
    label && (
      <span data-copy-label data-copy-success={labelSuccess}>
        {label}
      </span>
    )
  }

  {/* copy icon */}
  <Icon
    class="self-center group-[.copied]/btn:hidden"
    name="material-symbols:content-copy-outline"
    height={21}
    width={21}
    aria-hidden="true"
  />

  {/* success icon */}
  <Icon
    class="hidden self-center group-[.copied]/btn:block"
    name="material-symbols:check"
    height={21}
    width={21}
    aria-hidden="true"
  />
</button>

<script>
  function initClickToCopy() {
    const btns = document.querySelectorAll<HTMLButtonElement>("[data-copy-btn]");
    if (!btns.length) return;

    btns.forEach((btn) => {
      if (btn.dataset.bound === "true") return;
      btn.dataset.bound = "true";

      const text = btn.dataset.copyText;
      const label = btn.querySelector<HTMLElement>("[data-copy-label]");

      if (!text || !navigator.clipboard) {
        btn.disabled = true;
        btn.setAttribute("aria-disabled", "true");
        return;
      }

      btn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(text);

          btn.classList.add("copied");
          setTimeout(() => {
            btn.classList.remove("copied");
          }, 1500);

          if (label) {
            const original = label.textContent;
            const success = label.getAttribute("data-copy-success");

            label.textContent = success;

            setTimeout(() => {
              label.textContent = original;
            }, 1500);
          }
        } catch (err) {
          console.error("Copy failed:", err);
        }
      });
    });
  }

  document.addEventListener("DOMContentLoaded", initClickToCopy);
</script>

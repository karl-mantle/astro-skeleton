---
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";
import { Image } from "astro:assets";
import { imagesConfig } from "~/site.config";

interface Props extends HTMLAttributes<"div"> {
  description?: string;
  image?: {
    src: ImageMetadata;
    alt?: string;
  };
  name: string;
}

const { description, image, name }: Props = Astro.props;
---

<div class="flex flex-row gap-4">
  {
    image && (
      <div class="h-12 w-12">
        <Image
          alt={image.alt ?? ""}
          class="aspect-square rounded-full object-cover"
          format="webp"
          loading="eager"
          src={image.src}
          height={imagesConfig.thumbnail.height}
          width={imagesConfig.thumbnail.width}
        />
      </div>
    )
  }
  <div class:list={["flex flex-col text-sm", description && "gap-1"]}>
    <span class="font-medium">{name}</span>
    {description && <span>{description}</span>}
  </div>
</div>

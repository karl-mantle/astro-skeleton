---
import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";

interface Props extends HTMLAttributes<"div"> {
  description?: string;
  heading: string;
  icon: {
    name: string;
    size?: number;
  };
  layout?: {
    center?: boolean;
    direction?: "row" | "column";
  };
}

const { description, heading, icon, layout = {}, class: className }: Props = Astro.props;
---

<div
  class:list={[
    "card not-prose bg-base-200 dark:bg-base-800 flex gap-2 p-4 md:gap-4",
    layout.center === true && "items-center text-center",
    layout.direction === "row" ? "flex-row" : "flex-col",
    className,
  ]}
>
  {
    icon && (
      <div class="bg-base-50 dark:bg-base-950 h-fit w-fit p-2">
        <Icon name={icon.name} height={icon.size ?? 32} width={icon.size ?? 32} />
      </div>
    )
  }

  <div class="flex flex-col gap-2">
    <h3>{heading}</h3>
    {description && <p>{description}</p>}
  </div>
</div>

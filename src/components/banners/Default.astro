---
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";
import { Picture } from "astro:assets";
import { imagesConfig } from "~/site.config";
import BtnGroup from "~/components/ui/buttons/Group.astro";
import Vimeo from "~/components/media/videos/Vimeo.astro";
import YouTube from "~/components/media/videos/YouTube.astro";

interface Props extends HTMLAttributes<"section"> {
  btns?: {
    href: string;
    label: string;
    type: "primary" | "secondary" | "text" | "icon";
  }[];
  description: string;
  heading: string;
  image?: {
    alt: string | null;
    src: ImageMetadata;
  };
  layout?: {
    aspect?: "auto" | "landscape" | "portrait" | "square" | "video";
    mirror?: boolean;
  };
  video?: {
    player: "vimeo" | "youtube";
    src: string;
  };
}

const aspectMap = {
  auto: "aspect-auto",
  landscape: "aspect-[4/3]",
  portrait: "aspect-[3/4]",
  square: "aspect-square",
  video: "aspect-video",
};

const { btns, description, heading, image, layout, video, class: className }: Props = Astro.props;
---

<section class:list={["mt-20 overflow-hidden md:mt-12", className]}>
  <div
    class="contain relative flex h-full w-full flex-col-reverse items-center gap-4 py-4 md:grid md:grid-cols-2 md:gap-8 md:p-0"
  >
    <div
      class:list={[
        "flex h-full flex-col justify-center gap-4 md:py-16",
        layout?.mirror && "md:order-2",
        !image && !video && "md:col-span-2",
      ]}
    >
      <div class="flex max-w-[75ch] flex-col gap-4">
        <h2>{heading}</h2>
        {description && <p>{description}</p>}
      </div>

      {btns && btns.length > 0 && <BtnGroup btns={btns} />}
    </div>

    {
      image && !video && (
        <>
          <Picture
            alt={image.alt ?? ""}
            class:list={["h-full w-full object-cover", aspectMap[layout?.aspect ?? "auto"]]}
            format="webp"
            loading="eager"
            sizes={imagesConfig.half.sizes}
            src={image.src}
            widths={imagesConfig.half.widths}
          />
        </>
      )
    }

    {
      video && (
        <>
          {video.player === "vimeo" && (
            <Vimeo class="!max-w-none" url={video.src} params="dnt=1" data-bg-video />
          )}
          {video.player === "youtube" && (
            <YouTube url={video.src} params="enablejsapi=1" loop={true} data-bg-video />
          )}
        </>
      )
    }
  </div>
</section>

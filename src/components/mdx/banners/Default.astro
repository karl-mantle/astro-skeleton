---
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";
import { Picture } from "astro:assets";
import BtnGroup from "~/components/ui/buttons/Group.astro";

interface Props extends HTMLAttributes<"section"> {
  btns?: {
    href: string;
    label: string;
    type: "primary" | "secondary" | "text" | "icon";
  }[];
  description?: string;
  heading: string;
  image?: {
    alt?: string;
    aspect?: "square" | "video";
    position?: "left" | "right";
    src: ImageMetadata;
  };
}

const { btns = [], description, heading, image, class: className }: Props = Astro.props;
---

<section class:list={["bg-base-200 dark:bg-base-800 py-4 md:py-16", className]}>
  <div
    class:list={[
      "contain flex flex-col-reverse",
      image && "items-center gap-4 md:grid md:grid-cols-2 md:gap-8",
    ]}
  >
    <div
      class:list={[
        "flex max-w-[75ch] flex-col gap-2 md:gap-4",
        image?.position === "left" && "md:order-2",
      ]}
    >
      <h2>{heading}</h2>
      {description && <p>{description}</p>}
      {btns?.length > 0 && <BtnGroup btns={btns} />}
    </div>

    {
      image && (
        <div>
          <Picture
            src={image.src}
            widths={[480, 960]}
            sizes={`(max-width: 640px) 480px`}
            inferSize
            formats={["webp"]}
            loading="lazy"
            class:list={[
              "object-cover",
              image.aspect === "square" && "aspect-square",
              image.aspect === "video" && "aspect-video",
              !image.aspect && "aspect-auto",
            ]}
            alt={image.alt ?? ""}
          />
        </div>
      )
    }
  </div>
</section>

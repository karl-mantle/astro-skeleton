---
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";
import { Picture } from "astro:assets";
import { imagesConfig } from "~/site.config";
import BtnGroup from "~/components/ui/buttons/Group.astro";
import Vimeo from "~/components/mdx/media/videos/Vimeo.astro";
import YouTube from "~/components/mdx/media/videos/YouTube.astro";

interface Props extends HTMLAttributes<"header"> {
  btns?: {
    href: string;
    label: string;
    type: "primary" | "secondary" | "text" | "icon";
  }[];
  description: string;
  heading: string;
  layout?: {
    height?: "screen" | "default";
  };
  image?: {
    alt: string | null;
    src: ImageMetadata;
  };
  video?: {
    player: "vimeo" | "youtube";
    src: string;
  };
}

const {
  btns,
  description,
  heading,
  image,
  layout = {},
  video,
  class: className,
}: Props = Astro.props;
---

<header
  class:list={[
    "not-prose relative flex w-full flex-col overflow-hidden",
    layout.height === "screen" ? "h-screen" : "h-full",
    className,
  ]}
>
  {
    image && !video && (
      <>
        <div class="relative md:absolute md:inset-0">
          <Picture
            alt={image.alt ?? ""}
            class="h-full w-full object-cover"
            format="webp"
            loading="eager"
            sizes={imagesConfig.full.sizes}
            src={image.src}
            widths={imagesConfig.full.widths}
          />
          <div class="absolute inset-0 z-2 bg-gradient-to-t from-black/10 to-black/70 md:from-black/25 md:to-black/75" />
        </div>
      </>
    )
  }

  {
    video && (
      <>
        <div class="max-md:relative md:absolute md:inset-0 md:overflow-hidden 2xl:scale-110">
          {video.player === "vimeo" && (
            <Vimeo
              class="!mb-0 !max-w-none"
              url={video.src}
              params="mute=0&loop=1&rel=0&muted=1&background=1&controls=0&dnt=1"
              data-bg-hero-video
            />
          )}
          {video.player === "youtube" && (
            <YouTube
              class="!mb-0"
              url={video.src}
              params={`mute=1&rel=0&autoplay=1&playsinline=1&enablejsapi=1&showinfo=0`}
              loop={true}
              data-bg-hero-video
            />
          )}

          <div class="absolute inset-0 z-2 bg-gradient-to-t from-black/10 to-black/70 md:from-black/25 md:to-black/75" />
        </div>
      </>
    )
  }

  <div
    class="bg-base-950 contain dark z-5 flex h-full flex-col justify-end gap-4 py-4 text-white md:bg-transparent md:pt-36 md:pb-16"
  >
    <div class="flex flex-col gap-2 md:gap-4">
      <h1 class="max-w-[75ch]">{heading}</h1>
      {description && <p class="max-w-[75ch]">{description}</p>}
    </div>

    {btns && btns.length > 0 && <BtnGroup btns={btns} />}
  </div>
</header>

<script>
  function initBgVideo() {
    const bgVideo = document.querySelector("[data-bg-hero-video]") as HTMLElement;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && !bgVideo.classList.contains("ltv-activated")) {
            bgVideo.click();
            observer.unobserve(bgVideo);
          }
        });
      },
      { threshold: 0.25 },
    );

    observer.observe(bgVideo);

    document.getElementById("site-header")?.classList.add("dark");
  }

  document.addEventListener("DOMContentLoaded", initBgVideo);
</script>

---
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";
import { Picture } from "astro:assets";
import { imagesConfig } from "~/site.config";
import BtnGroup from "~/components/ui/buttons/Group.astro";
import Vimeo from "~/components/mdx/media/videos/Vimeo.astro";
import YouTube from "~/components/mdx/media/videos/YouTube.astro";

interface Props extends HTMLAttributes<"header"> {
  btns?: {
    href: string;
    label: string;
    type: "primary" | "secondary" | "text" | "icon";
  }[];
  description: string;
  heading: string;
  image?: {
    alt: string | null;
    src: ImageMetadata;
  };
  layout?: {
    aspect?: "default" | "square" | "video";
    mirror?: boolean;
  };
  video?: {
    player: "vimeo" | "youtube";
    src: string;
  };
}

const aspectMap = {
  default: "aspect-[4/3]",
  square: "aspect-square",
  video: "aspect-video",
};

const {
  btns,
  description,
  heading,
  image,
  layout = {},
  video,
  class: className,
}: Props = Astro.props;
---

<header
  class:list={[
    "relative mt-20 grid h-full w-full grid-cols-1 items-center gap-2 overflow-hidden md:grid md:grid-cols-2 md:gap-4",
    className,
  ]}
>
  <div
    class:list={[
      "contain z-5 order-last flex h-full flex-col justify-center gap-2 py-8 md:order-first md:gap-4 lg:py-16",
      layout.mirror && "md:order-last",
    ]}
  >
    <div class="flex max-w-[75ch] flex-col gap-2 md:gap-4">
      <h1>{heading}</h1>
      {description && <p>{description}</p>}
    </div>

    {btns && btns.length > 0 && <BtnGroup btns={btns} />}
  </div>

  {
    image && !video && (
      <>
        <div class:list={["relative overflow-hidden", layout.aspect && aspectMap[layout.aspect]]}>
          <Picture
            alt={image.alt ?? ""}
            class="h-full w-full object-cover"
            format="webp"
            loading="eager"
            sizes={imagesConfig.full.sizes}
            src={image.src}
            widths={imagesConfig.full.widths}
          />

          <div class="absolute inset-0 z-2 bg-gradient-to-t from-black/5 to-black/75" />
        </div>
      </>
    )
  }

  {
    video && (
      <>
        <div class:list={["relative overflow-hidden", layout.aspect && aspectMap[layout.aspect]]}>
          {video.player === "vimeo" && (
            <Vimeo
              class="!max-w-none md:scale-120"
              url={video.src}
              params="mute=0&loop=1&rel=0&muted=1&background=1&controls=0&dnt=1"
              data-bg-video
            />
          )}
          {video.player === "youtube" && (
            <YouTube
              class="md:scale-120"
              url={video.src}
              params={`mute=1&rel=0&autoplay=1&playsinline=1&enablejsapi=1&showinfo=0`}
              loop={true}
              data-bg-video
            />
          )}

          <div class="absolute inset-0 z-2 bg-gradient-to-t from-black/25 to-black/75" />
        </div>
      </>
    )
  }
</header>

<script>
  function initBgVideos() {
    const bgVideos = document.querySelectorAll<HTMLElement>("[data-bg-video]");

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const el = entry.target as HTMLElement;

          if (entry.isIntersecting && !el.classList.contains("ltv-activated")) {
            el.click();
          }
        });
      },
      {
        threshold: 0.25, // ! adjust threshold
      },
    );

    bgVideos.forEach((el) => observer.observe(el));
  }

  document.addEventListener("DOMContentLoaded", initBgVideos);
</script>

---
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";
import MiniProfile from "~/components/ui/MiniProfile.astro";

interface Props extends HTMLAttributes<"figure"> {
  attribution?: {
    name: string;
    description?: string;
    date?: Date;
    image?: {
      src: ImageMetadata;
      alt?: string;
    };
  };
  layout?: {
    center?: boolean;
  };
  quote: string;
}

const { attribution, layout = {}, quote, class: className }: Props = Astro.props;
---

<figure
  class:list={[
    "card not-prose bg-base-200 dark:bg-base-800 relative flex flex-col gap-2 p-4 md:gap-4",
    layout.center === true && "items-center text-center",
    className,
  ]}
>
  <Icon
    class="absolute top-0 left-0 rotate-180 opacity-25"
    name="material-symbols:format-quote"
    height={48}
    width={48}
  />
  <blockquote class="z-5 font-medium md:text-xl">
    <p>{quote}</p>
  </blockquote>
  <Icon
    class="absolute right-0 bottom-0 opacity-25"
    name="material-symbols:format-quote"
    height={48}
    width={48}
  />

  {
    attribution && (
      <figcaption class="z-5">
        <MiniProfile
          description={attribution.description}
          image={attribution.image}
          name={attribution.name}
        />
      </figcaption>
    )
  }
</figure>

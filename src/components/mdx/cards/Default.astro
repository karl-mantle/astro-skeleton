---
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";
import { Picture } from "astro:assets";
import { imagesConfig } from "~/site.config";
import BtnGroup from "~/components/ui/buttons/Group.astro";

interface Props extends HTMLAttributes<"div"> {
  btns?: {
    href: string;
    label: string;
    type: "primary" | "secondary" | "text" | "icon";
  }[];
  description?: string;
  heading: string;
  image?: {
    alt: string | null;
    src: ImageMetadata;
  };
  layout?: {
    center?: boolean;
    direction?: "row" | "column";
  };
}

const { btns, description, heading, image, layout = {}, class: className }: Props = Astro.props;
---

<div
  class:list={[
    "card not-prose bg-base-200 dark:bg-base-800 flex gap-2 p-4 md:gap-4",
    layout.center === true && "items-center text-center",
    layout.direction === "row" ? "flex-row" : "flex-col",
    className,
  ]}
>
  {
    image && (
      <Picture
        alt={image.alt ?? ""}
        class="h-full w-full object-cover"
        format="webp"
        loading="lazy"
        sizes={imagesConfig.third.sizes}
        src={image.src}
        widths={imagesConfig.third.widths}
      />
    )
  }

  <div class="flex flex-col gap-2">
    <h3>{heading}</h3>
    {description && <p>{description}</p>}
  </div>

  {btns && btns.length > 0 && <BtnGroup btns={btns} />}
</div>

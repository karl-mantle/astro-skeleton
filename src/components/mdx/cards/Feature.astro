---
import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";

interface Props extends HTMLAttributes<"div"> {
  center?: boolean;
  description?: string;
  heading: string;
  icon: string;
  size?: number;
}

const {
  center = true,
  description,
  heading,
  icon,
  size = 72,
  class: className,
}: Props = Astro.props;
---

<div
  class:list={[
    "card bg-base-200 dark:bg-base-800 flex flex-col gap-2 p-4 md:gap-4",
    center === true && "items-center text-center",
    className,
  ]}
>
  <div class="bg-base-50 dark:bg-base-950 h-fit w-fit p-2">
    <Icon name={icon} height={size} width={size} />
  </div>
  <div class="flex flex-col gap-2">
    <h3>{heading}</h3>
    {description && <p class="text-base">{description}</p>}
  </div>
</div>

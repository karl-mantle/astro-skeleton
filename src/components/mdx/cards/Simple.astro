---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  center?: boolean;
  description?: string;
  heading: string;
}

const { center, description, heading, class: className }: Props = Astro.props;
---

<div
  class:list={[
    "card not-prose bg-base-200 dark:bg-base-800 flex flex-col gap-2 p-4 md:gap-4",
    center === true && "items-center text-center",
    className,
  ]}
>
  <h3>{heading}</h3>
  {description && <p>{description}</p>}
</div>

---
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";
import MiniProfile from "~/components/ui/MiniProfile.astro";

interface Props extends HTMLAttributes<"figure"> {
  attribution?: {
    name: string;
    description?: string;
    date?: Date;
    image?: {
      src: ImageMetadata;
      alt?: string;
    };
  };
  layout?: {
    center?: boolean;
  };
  quote: string;
  rating: number;
}

const { attribution, layout = {}, quote, rating, class: className }: Props = Astro.props;
---

<figure
  class:list={[
    "card not-prose bg-base-200 dark:bg-base-800 relative flex flex-col gap-2 p-4 md:gap-4",
    layout.center === true && "items-center text-center",
    className,
  ]}
>
  {
    rating > 0 && (
      <div class="z-5 flex gap-1">
        {Array.from({ length: 5 }, (_, i) => (
          <Icon
            name={i < rating ? "material-symbols:star" : "material-symbols:star-outline"}
            height={24}
            width={24}
          />
        ))}
      </div>
    )
  }

  <blockquote class="z-5 font-medium md:text-xl">
    <p>{quote}</p>
  </blockquote>

  {
    attribution && (
      <figcaption class="z-5">
        <MiniProfile
          description={attribution.description}
          image={attribution.image}
          name={attribution.name}
        />
      </figcaption>
    )
  }
</figure>

---
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";
import { Picture } from "astro:assets";
import { imagesConfig } from "~/site.config";

interface Props extends HTMLAttributes<"a"> {
  btn: {
    href: string;
    label?: string;
  };
  description?: string;
  heading: string;
  image?: {
    alt: string | null;
    src: ImageMetadata;
  };
  layout?: {
    center?: boolean;
    direction?: "row" | "column";
  };
}

const { btn, description, heading, image, layout = {}, class: className }: Props = Astro.props;
---

<a
  class:list={[
    "card group/card not-prose bg-base-200 dark:bg-base-800",
    layout.center === true && "items-center text-center",
    layout.direction === "row" ? "grid grid-cols-1 md:grid-cols-2" : "flex flex-col",
    className,
  ]}
  href={btn.href}
>
  {
    image && (
      <Picture
        alt={image.alt ?? ""}
        class="h-full w-full object-cover"
        format="webp"
        loading="lazy"
        sizes={imagesConfig.third.sizes}
        src={image.src}
        widths={imagesConfig.third.widths}
      />
    )
  }

  <div class="flex flex-col gap-2 p-4 md:gap-4">
    <h3 class="decoration-2 underline-offset-4 group-hover/card:underline">
      {heading}
    </h3>
    {description && <p class="text-base">{description}</p>}
  </div>
</a>

---
import { Icon } from "astro-icon/components";

const iconSize = 24;
---

<li>
  <button
    id="search-open-btn"
    class="hover:bg-base-200 dark:hover:bg-base-800 focus-visible:bg-focus-color cursor-pointer border-b-2 border-transparent p-2 transition-colors duration-300 focus-visible:border-black focus-visible:text-black"
    type="button"
    aria-controls="search-modal"
    aria-expanded="false"
    aria-label="Open search modal"
  >
    <Icon name="material-symbols:search" height={iconSize} width={iconSize} />
  </button>
</li>

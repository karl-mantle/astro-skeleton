---
import { Image } from "astro:assets";
import { generalConfig } from "~/site.config";
import Navigation3Levels from "~/components/layout/header/navigation/Navigation3Levels.astro";
import NavigationBtn from "~/components/layout/header/buttons/Navigation.astro";
import SearchBtn from "~/components/layout/header/buttons/Search.astro";
import ThemeBtn from "~/components/layout/header/buttons/Theme.astro";
import SiteLogo from "~/assets/svg/logo-1-1.svg";
---

<header id="site-header" class="absolute top-0 right-0 left-0 z-50">
  <div class="contain dark:text-base-50 flex h-20 justify-between p-4">
    <a
      class="group/logo focus-visible:bg-focus-color flex flex-row items-center gap-4 border-b-2 border-transparent text-xl font-medium focus-visible:border-black focus-visible:text-black"
      href={import.meta.env.BASE_URL}
      aria-label="Return to home page"
    >
      <Image class="aspect-square w-8 object-contain" src={SiteLogo} alt="" format="svg" />
      <span
        class="group-hover/logo:border-base-900 hidden border-b-2 border-transparent transition-colors duration-300 group-focus-visible/logo:text-black md:block dark:group-hover/logo:border-white"
        >{generalConfig.short_name}</span
      >
    </a>

    <Navigation3Levels />

    <ul class="flex gap-2" aria-label="Site controls">
      <SearchBtn />
      <ThemeBtn />
      <NavigationBtn />
    </ul>
  </div>
</header>

---
import type { HTMLAttributes } from "astro/types";
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import { imagesConfig } from "~/site.config";

interface Props extends HTMLAttributes<"div"> {
  id: string;
}

const { id = "default" } = Astro.props;

const profile = await getEntry("profiles", id);
---

<div class="flex flex-row justify-between gap-4">
  {
    profile?.data.image && (
      <div class="h-16 w-16">
        <Image
          alt={`Profile picture for ${profile.data.title}`}
          class="aspect-square rounded-full object-cover"
          format="webp"
          loading="eager"
          src={profile.data.image.src}
          height={imagesConfig.thumbnail.height}
          width={imagesConfig.thumbnail.width}
        />
      </div>
    )
  }
  <div class="flex flex-col gap-1 text-sm">
    <span class="font-medium" data-pagefind-filter={`author:${profile?.data.title}`}
      >{profile?.data.title}</span
    >
    <span>{profile?.data.role}</span>
  </div>
</div>

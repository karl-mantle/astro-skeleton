---
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";
import { Picture } from "astro:assets";
import { collectionsConfig } from "~/site.config";
import slugify from "slugify";
import Date from "~/components/ui/Date.astro";
import MiniProfile from "~/components/collections/profiles/MiniProfile.astro";
import TextBtn from "~/components/ui/buttons/TextBtn.astro";

interface Props extends HTMLAttributes<"header"> {
  authorId: string;
  category: string;
  date: Date;
  description: string;
  heading: string;
  image?: {
    alt?: string;
    src: ImageMetadata;
  };
}

const { authorId, category, date, heading, image }: Props = Astro.props;
---

<header class="flex flex-col gap-4 md:gap-8">
  {
    image && (
      <Picture
        src={image.src}
        widths={[480, 960]}
        sizes={`(max-width: 640px) 480px`}
        inferSize
        formats={["webp"]}
        loading="eager"
        class="aspect-video object-cover"
        alt={image.alt ?? ""}
      />
    )
  }

  <h1 class="font-serif">{heading}</h1>

  <div class="flex flex-col justify-between gap-2 md:flex-row">
    <MiniProfile id={authorId} />

    <div class="flex h-fit items-baseline gap-1 text-sm font-medium">
      <Date class="self-center" date={date} />
      <span>|</span>
      <TextBtn
        href={`${import.meta.env.BASE_URL}${collectionsConfig.permalink_posts_category}${slugify(category, { lower: true })}`}
        label={category}
        data-pagefind-filter={`category:${category}`}
      />
    </div>
  </div>
</header>
